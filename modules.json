      "desing": {
        "name": {
          "tr": "Mesut Doğan Vinç'i Tanıyın"
        },
        "spot": {
          "tr": "Firmamızın kuruluşundan bu yana başarı ile sunduğu ve geliştirdiği hizmetler sayesinde yerel ve bölgesel düzeyde önemli başarılara adını yazdırmıştır. Güçlü Referanslarımızda Başarılarımıza Ortaktır. Bu başarının ve gelişimin arkasında nitelikli insan kaynağımız, bilgi birikimimiz ve güvene dayalı iş ilişkilerimiz yer almaktadır."
        },
        "name2": {
          "tr": "Vizyonumuz"
        },
        "spot2": {
          "tr": "Sektörümüzde öncü ve yenilikçi yaklaşımlarla müşterilerimize en iyi hizmeti sunarak, güvenilir ve tercih edilen bir marka olmayı hedefliyoruz."
        },
        "icon2": "home",
        "name3": {
          "tr": "Misyonumuz"
        },
        "spot3": {
          "tr": "Yenilikçi teknolojiler ve kaliteli hizmet anlayışıyla müşterilerimize en iyi vinç hizmetlerini sunarak sektörde lider konuma ulaşmak."
        },
        "icon3": "home",
